FLASK_APP=run.py
FLASK_ENV=development
# 1 enables the interactive debugger (remote code execution if exposed).
# Leave at 0 unless you are developing locally on 127.0.0.1.
FLASK_DEBUG=0

# --- Secrets -------------------------------------------------------------
# Generate each one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Both must be at least 32 characters (HS256 minimum). Never commit real values;
# production refuses to start while either is still a placeholder.
SECRET_KEY=change-this-to-a-random-secret-key
JWT_SECRET_KEY=change-this-to-a-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES=86400

# --- Database ------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/stockinvoice

# --- Sessions / CSRF -----------------------------------------------------
# Set to 1 whenever the app is served over HTTPS.
COOKIE_SECURE=0

# Self-service registration creates accounts that are not attached to any
# company. Keep it off unless you want open sign-ups.
ALLOW_PUBLIC_REGISTRATION=0

# --- Auth throttling (per client IP, in-process) -------------------------
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW=300

# --- Microservices -------------------------------------------------------
# RabbitMQ broker used by every domain service (events, retries, DLQs).
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2f

# Internal REST endpoints of the domain services (the BFF calls these).
# In docker compose they are overridden to http://<service>:<port>.
IDENTITY_URL=http://localhost:8001
INVENTORY_URL=http://localhost:8002
SALES_URL=http://localhost:8003
PROCUREMENT_URL=http://localhost:8004
WORKERS_URL=http://localhost:8005

# Shared key for service-to-service calls that carry no browser session
# (e.g. a background worker looking up a user). Generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=si-internal-dev-key
