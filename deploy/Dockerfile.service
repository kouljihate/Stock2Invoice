# Generic image for the StockInvoice domain services.
# Build with:  --build-arg SERVICE=identity
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

ARG SERVICE
ENV SERVICE=${SERVICE}

WORKDIR /srv

# Shared kernel first for layer caching.
COPY shared /srv/shared
RUN pip install /srv/shared

COPY services/${SERVICE} /srv/service
RUN pip install "uvicorn[standard]>=0.27" requests

WORKDIR /srv/service

# Least privilege: the app writes nothing to disk (state lives in Mongo,
# logs go to stdout), so drop root before serving traffic.
RUN useradd --create-home --uid 10001 --user-group appuser \
 && chown -R appuser:appuser /srv
USER appuser

EXPOSE 8001

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${SERVICE_PORT:-8001}"]
